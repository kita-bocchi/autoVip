{
  "package": "com.mipay.wallet",
  "serial": "",
  "device_wait_seconds": 120,
  "humanize": true,
  "network_check": true,
  "network_retries": 3,
  "network_settle": 25,
  "success_keywords": [
    "已领取",
    "明日再来",
    "明天再来"
  ],
  "steps": [
    {
      "do": "widget",
      "cold": true,
      "desc": "回桌面，从「钱包玩家视界」小组件进活动页（冷启动能刷出看广告任务）"
    },
    {
      "do": "sleep",
      "seconds": 3.0,
      "desc": "等 H5 活动页渲染"
    },
    {
      "do": "click",
      "texts": [
        "跳过",
        "关闭",
        "我知道了",
        "以后再说"
      ],
      "timeout": 3,
      "optional": true,
      "desc": "关掉开屏/弹窗"
    },
    {
      "do": "click",
      "texts": [
        "领视频会员",
        "会员中心"
      ],
      "timeout": 12,
      "optional": true,
      "desc": "从首页进玩家视界（App 已停在该页时找不到属正常）"
    },
    {
      "do": "sleep",
      "seconds": 3.0,
      "desc": "等 H5 活动页加载"
    },
    {
      "do": "ad_tasks",
      "rounds": 4,
      "page_rounds": 4,
      "page_reenter": 2,
      "page_watch_seconds": 14,
      "max_seconds": 100,
      "watch_keywords": [
        "去观看",
        "看广告",
        "立即观看",
        "观看广告",
        "看视频",
        "观看视频",
        "去浏览",
        "去看看",
        "立即播放"
      ],
      "skip_keywords": [
        "去下载",
        "去完成",
        "换一个",
        "去邀请",
        "已领取"
      ],
      "close_keywords": [
        "关闭",
        "跳过广告",
        "跳过",
        "×",
        "领取奖励"
      ],
      "optional": false,
      "desc": "逐个完成看广告任务",
      "grace_seconds": 8,
      "page_reenter_waits": [
        120,
        300
      ]
    },
    {
      "do": "trial_tasks",
      "desc": "逐个完成试用任务（下载→安装→试用30秒→领取）",
      "rounds": 8,
      "install_timeout": 420,
      "browse_seconds": 35,
      "dialog_timeout": 25,
      "dialog_keywords": [
        "同意",
        "始终允许",
        "仅在使用中允许",
        "允许",
        "我知道了",
        "跳过",
        "以后再说"
      ]
    },
    {
      "do": "sleep",
      "seconds": 2.0,
      "desc": "等结果回显"
    },
    {
      "do": "shot",
      "desc": "结束截图"
    }
  ],
  "max_retry": 2,
  "skip_if_done": true,
  "notify_webhook": "",
  "panel_debug": true,
  "ad_target": 3
}